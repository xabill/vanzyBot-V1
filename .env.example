# ==================================================
#                 VANZYBOT SYSTEM
#     Advanced WhatsApp Bot (BAILEYS FRAMEWORK)
# ==================================================


# ─────────────────────────────────────────────
# BOT CORE IDENTITY
# ─────────────────────────────────────────────
BOT_NAME=vanzyBot
BOT_PREFIX=,!,.,-,#,•

BOT_PUBLIC=true
# true  = semua user bisa akses bot
# false = hanya owner

BOT_VERSION=1.0.0
BOT_DESCRIPTION=vanzyBot - Advanced WhatsApp Automation System
BOT_STATUS=online

BOT_LANGUAGE=id
BOT_REGION=ID


# ─────────────────────────────────────────────
# OWNER SYSTEM
# ─────────────────────────────────────────────
# format: 628xxx,628xxx (tanpa @s.whatsapp.net)
BOT_OWNER=6283865204595

OWNER_NAME=vanzyDev
OWNER_CONTACT=wa.me/6283865204595

SUDO_MODE=true
DEVELOPER_MODE=false
OWNER_ONLY_COMMANDS=false


# ─────────────────────────────────────────────
# PAIRING SYSTEM (WHATSAPP LINK)
# ─────────────────────────────────────────────
PAIRING_ENABLED=true
PAIRING_NUMBER=6283865204595

# optional pairing code manual
PAIRING_CUSTOM_CODE=

# allow everyone pairing
PAIRING_ALLOW_ALL=false

# auto connect after pairing success
PAIRING_AUTO_CONNECT=true

# timeout pairing (seconds)
PAIRING_TIMEOUT=120

# retry pairing attempts
PAIRING_RETRY=3


# ─────────────────────────────────────────────
# SESSION MANAGEMENT
# ─────────────────────────────────────────────
SESSION_NAME=vanzy-session
SESSION_FOLDER=./session

SESSION_AUTO_RESTART=true
SESSION_CLEAN_ON_LOGOUT=true
SESSION_SAVE_INTERVAL=30000

SESSION_BACKUP_ENABLED=true
SESSION_BACKUP_PATH=./backup/session


# ─────────────────────────────────────────────
# WEB DASHBOARD / PANEL
# ─────────────────────────────────────────────
WEB_ENABLED=true
WEB_PORT=3000
WEB_HOST=0.0.0.0

WEB_TITLE=vanzyBot Control Panel
WEB_THEME=dark

WEB_AUTH=false
WEB_USERNAME=admin
WEB_PASSWORD=admin123

WEB_QR=true
WEB_STATUS_PAGE=true
WEB_API_ENDPOINT=/api/status


# ─────────────────────────────────────────────
# STICKER SYSTEM
# ─────────────────────────────────────────────
STICKER_PACKNAME=© vanzyBot
STICKER_AUTHOR=vanzyBot
STICKER_WATERMARK=true
STICKER_REMOVE_BG=false

STICKER_AUTO=true
STICKER_QUALITY=high


# ─────────────────────────────────────────────
# API SYSTEM
# ─────────────────────────────────────────────
API_BASE_URL=https://api.example.com
API_KEY=
API_TIMEOUT=15000
API_RETRY=3
API_RATE_LIMIT=true

API_LOGGING=true


# ─────────────────────────────────────────────
# AI SYSTEM (OPTIONAL)
# ─────────────────────────────────────────────
AI_ENABLED=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=

AI_AUTO_REPLY=false
AI_CHAT_MODE=false
AI_MEMORY=false


# ─────────────────────────────────────────────
# SECURITY SYSTEM
# ─────────────────────────────────────────────
ANTI_SPAM=true
ANTI_LINK=true
ANTI_BOT=false
ANTI_DELETE=false
ANTI_VIRUS=false

RATE_LIMIT=true
COOLDOWN_SECONDS=3
MAX_REQUEST_PER_MINUTE=60

BLOCKED_PREFIXES=wa.me,https,http,t.me


# ─────────────────────────────────────────────
# GROUP MANAGEMENT
# ─────────────────────────────────────────────
WELCOME_GROUP=true
GOODBYE_GROUP=true
AUTO_REACT=true
AUTO_READ=true
AUTO_STICKER=false

GROUP_ANTI_LINK=true
GROUP_ANTI_SPAM=true
GROUP_WELCOME_IMAGE=false


# ─────────────────────────────────────────────
# PERFORMANCE SYSTEM
# ─────────────────────────────────────────────
KEEP_ALIVE_INTERVAL=10000
PRESENCE_UPDATE=true

MAX_MEMORY_MB=512
CACHE_LIMIT=500

AUTO_RECONNECT=true
RECONNECT_DELAY=3000
MAX_RECONNECT_ATTEMPTS=999

THREADS=2
CLUSTER_MODE=false


# ─────────────────────────────────────────────
# LOGGING & DEBUG
# ─────────────────────────────────────────────
LOG_LEVEL=silent
DEBUG_MODE=false

SHOW_QR=true
SHOW_CONNECTION_LOG=true
SHOW_ERRORS=true

SAVE_LOG_FILE=true
LOG_FILE=./logs/bot.log


# ─────────────────────────────────────────────
# PLUGIN SYSTEM
# ─────────────────────────────────────────────
PLUGIN_FOLDER=./plugins
AUTO_LOAD_PLUGINS=true
PLUGIN_ERROR_IGNORE=true
PLUGIN_HOT_RELOAD=false


# ─────────────────────────────────────────────
# DATABASE (OPTIONAL)
# ─────────────────────────────────────────────
DATABASE_TYPE=none

MONGO_URI=

MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=vanzybot

DB_POOL_LIMIT=10


# ─────────────────────────────────────────────
# BACKUP SYSTEM
# ─────────────────────────────────────────────
AUTO_BACKUP=true
BACKUP_INTERVAL=24h
BACKUP_FOLDER=./backup
BACKUP_MAX_FILES=7


# ─────────────────────────────────────────────
# SYSTEM CORE
# ─────────────────────────────────────────────
NODE_ENV=production

ENABLE_CLUSTER=false
WORKER_THREADS=2
FORK_MODE=false

TIMEZONE=Asia/Jakarta


# ─────────────────────────────────────────────
# SECURITY TOKENS
# ─────────────────────────────────────────────
JWT_SECRET=vanzybot_jwt_secret_key
SESSION_SECRET=vanzybot_session_secret_key
ENCRYPTION_KEY=vanzybot_encryption_key

TOKEN_EXPIRY=7d


# ─────────────────────────────────────────────
# ADVANCED FEATURES
# ─────────────────────────────────────────────
FEATURE_DOWNLOAD=true
FEATURE_CONVERTER=true
FEATURE_AI=false
FEATURE_GROUP_MANAGER=true
FEATURE_AUTOMATION=true
FEATURE_GAME=false
FEATURE_RPG=false


# ─────────────────────────────────────────────
# UPDATE SYSTEM
# ─────────────────────────────────────────────
AUTO_UPDATE=false
UPDATE_CHECK_INTERVAL=3600


# ─────────────────────────────────────────────
# END CONFIGURATION
# ─────────────────────────────────────────────
